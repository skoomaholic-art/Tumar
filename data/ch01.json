    "text": "Март 1942. Аул Карасу, Акмолинская область."
  },
  "objectives": {
    "talk": "Поговорить с отцом у загона",
    "bring": "Принести жерди: {n}/3",
    "attach": "Приладить жердь к загону: {n}/3",
    "last": "Принести последнюю жердь",
    "evening": "Вечер. Зайти в дом"
  },
  "scripts": {
    "father_intro": [
      {
        "say": "Отец",
        "text": "Проснулся. Жерди сами себя не поставят."
      },
      {
        "say": "Асан",
        "text": "Сколько осталось, әке?"
      },
      {
        "say": "Отец",
        "text": "Три. Принеси от дома. До окота надо закрыть."
      }
    ],
    "pole_1": [
      {
        "say": "Отец",
        "text": "Крепче держи. Не глазами — руками."
      }
    ],
    "father_story": [
      {
        "say": "Отец",
        "text": "В тридцать втором здесь не было ни одного ягнёнка. Ни одного."
      },
      {
        "choose": "Отец",
        "text": "(Отец смотрит в степь и молчит.)",
        "timer": 9,
        "silent": 2,
        "options": [
          {
            "text": "Расскажи, әке.",
            "set": {
              "father": "told"
            },
            "then": [
              {
                "say": "Отец",
                "text": "Мы ушли на юг пешком. Коня отдал за четыре пуда зерна."
              },
              {
                "say": "Отец",
                "text": "Твоя сестра была меньше Күләш. Мы её не донесли."
              },
              {
                "say": "Отец",
                "text": "Хлеб не роняют, Асан. Никогда."
              },
              {
                "relation": {
                  "who": "father",
                  "delta": 1
                }
              },
              {
                "remember": "Отец это запомнит: ты спросил о тридцать втором"
              }
            ]
          },
          {
            "text": "Не надо. Что прошло, то прошло.",
            "set": {
              "father": "closed"
            },
            "then": [
              {
                "say": "Отец",
                "text": "Правильно. Работай."
              },
              {
                "remember": "Отец это запомнит: ты не стал спрашивать"
              }
            ]
          },
          {
            "text": "[Промолчать]",
            "set": {
              "father": "silent"
            },
            "then": [
              {
                "say": "Отец",
                "text": "…"
              },
              {
                "relation": {
                  "who": "father",
                  "delta": -1
                }
              },
              {
                "remember": "Отец заметил, что ты промолчал"
              }
            ]
          }
        ]
      }
    ],
    "rider": [
      {
        "say": "Всадник",
        "text": "Нурбеков! Нурбеков Асан Нурбекович — кто?",
        "lang": "ru"
      },
      {
        "call": "cut",
        "args": [
          "rev"
        ]
      },
      {
        "say": "Отец",
        "text": "(тихо, не сводя глаз с всадника) Что ему надо, Асан?"
      },
      {
        "say": "Асан",
        "text": "Не знаю, әке. Он называет наш род."
      },
      {
        "call": "cut",
        "args": [
          "kulash"
        ]
      },
      {
        "say": "Голос",
        "text": "(У юрты Күләш стоит с асыком в кулаке и не дышит.)"
      },
      {
        "call": "cut",
        "args": [
          "ots"
        ]
      },
      {
        "say": "Всадник",
        "text": "Асан Нурбекович! Ну? Кто из вас?",
        "lang": "ru"
      },
      {
        "once": "tip_noise",
        "then": [
          {
            "toast": "Асан почти не знает русского. Незнакомые слова звучат как шум."
          }
        ]
      },
      {
        "say": "Асан",
        "text": "…Асан. Мен — Асан."
      },
      {
        "testify": [
          "name",
          "Нурбеков Асан Нурбекович"
        ],
        "where": "аул, нарочный"
      },
      {
        "say": "Всадник",
        "text": "Ничего не понимают…",
        "lang": "ru"
      },
      {
        "close": true
      },
      {
        "call": "reachBag"
      },
      {
        "call": "paper"
      },
      {
        "say": "Всадник",
        "text": "Повестка. Распишись. Вот здесь.",
        "lang": "ru"
      },
      {
        "call": "cut",
        "args": [
          "sign"
        ]
      },
      {
        "say": "Голос",
        "text": "(Он суёт лист и огрызок карандаша, тычет пальцем в строчку. Асан выводит своё имя латинскими буквами — так его учили в аульной школе, до новых букв.)"
      },
      {
        "call": "sign"
      },
      {
        "say": "Всадник",
        "text": "Ладно. Сойдёт.",
        "lang": "ru"
      },
      {
        "close": true
      },
      {
        "call": "riderLeaves"
      },
      {
        "call": "readPaper"
      },
      {
        "call": "showDoc",
        "args": [
          false
        ]
      },
      {
        "call": "kulashRuns"
      },
      {
        "say": "Күләш",
        "text": "Дай! Нас в школе учили новым буквам. Я прочитаю!"
      },
      {
        "choose": "Асан",
        "text": "",
        "options": [
          {
            "text": "Отдать повестку Күләш",
            "set": {
              "sharedWithKulash": true
            },
            "then": [
              {
                "say": "Күләш",
                "text": "По-вест-ка… Я-вить-ся… за-втра… в во-ен-ко-мат. Это значит — тебя забирают."
              },
              {
                "word": [
                  "явиться",
                  "келу",
                  "Карандашом на обороте повестки"
                ]
              },
              {
                "word": [
                  "завтра",
                  "ертең",
                  "Карандашом на обороте повестки"
                ]
              },
              {
                "word": [
                  "военкомат",
                  "әскери комиссариат",
                  "Карандашом на обороте повестки"
                ]
              },
              {
                "word": [
                  "повестка",
                  "шақыру қағазы",
                  "Карандашом на обороте повестки"
                ]
              },
              {
                "relation": {
                  "who": "kulash",
                  "delta": 1
                }
              },
              {
                "remember": "Асан записал в блокнот четыре слова"
              },
              {
                "call": "showDoc",
                "args": [
                  true
                ]
              }
            ]
          },
          {
            "text": "Сам разберусь",
            "then": [
              {
                "say": "Асан",
                "text": "(Буквы не складываются в слова. Только своё имя.)"
              },
              {
                "word": [
                  "повестка",
                  "шақыру қағазы",
                  "Карандашом на обороте повестки"
                ]
              },
              {
                "relation": {
                  "who": "kulash",
                  "delta": -1
                }
              },
              {
                "remember": "Күләш обиделась. Она это запомнит"
              }
            ]
          }
        ]
      },
      {
        "say": "Отец",
        "text": "Иди в дом. Мать соберёт."
      },
      {
        "say": "Асан",
        "text": "А загон?"
      },
      {
        "say": "Отец",
        "text": "Вернёшься — доделаем."
      },
      {
        "diary": "22 марта 1942. Ясно, ветер северный, снег сходит. Ставили с отцом загон. Последнюю жердь не поставили."
      },
      {
        "if": "father==told",
        "then": [
          {
            "diary": "Отец рассказал про тридцать второй год. Про сестру."
          }
        ]
      },
      {
        "if": "father==silent",
        "then": [
          {
            "diary": "Отец что-то хотел сказать. Я промолчал."
          }
        ]
      },
      {
        "diary": "После обеда нарочный. Повестка. Завтра к восьми."
      },
      {
        "diary": "Отец: «Вернёшься — доделаем»."
      }
    ],
    "house_end": [
      {
        "diary": "Ночью мать шила. Отец отдал тумар. Загон не доделали."
      },
      {
        "if": "father==told",
        "then": [
          {
            "remember": "Отец отдал тебе свой тумар. Тумар вернётся в финале"
          }
        ],
        "else": [
          {
            "remember": "Отец отдал тумар, но не рассказал о нём. Может, расскажет потом"
          }
        ]
      }
    ]
  },
  "summons": "ПОВЕСТКА\nГражданин Нурбеков Асан\nВам надлежит явиться завтра к 8 часам в Акмолинский райвоенкомат.\nПри себе иметь кружку, ложку, смену белья.",
  "panels": {
