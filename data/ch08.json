{
  "id": "ch8",
  "title": "Фильтрация",
  "card": {
    "small": "Глава 8",
    "big": "Фильтрация",
    "text": "Май — август 1945. Мост через Энс, проверочно-фильтрационный лагерь.<br><span class=\"small\">Свои. Проволока. Протокол на восемь листов.</span>"
  },
  "covers": [
    "Мост",
    "Проволока снова",
    "Допросы",
    "Жумабай",
    "Вопрос о друге"
  ],
  "objectives": {
    "bridge": "Перейти мост к своим",
    "bridgeTouch": "Перейти мост к своим"
  },
  "ruBarks": [
    "Шевелись!",
    "Не растягиваться!",
    "Разговорчики!",
    "По четыре стройся!",
    "Кто отстанет — пеняй на себя."
  ],
  "texts": {
    "mark": "Ракитин что-то записал и подчеркнул.",
    "witnessFor": "Ракитин вычеркнул одну строчку.",
    "witnessAgainst": "Ракитин сделал пометку на полях.",
    "protocolHead": "Протокол допроса. Листов: 8. С моих слов записано верно, мною прочитано:",
    "protocolHint": "Последний лист. Распишись — как когда-то на повестке.",
    "protocolRead": "Протокол по-русски. Асан понимает русскую речь, но читать так и не научился — ни строчки."
  },
  "scripts": {
    "bridge": [
      {
        "caption": "Май 1945. Мост через Энс."
      },
      {
        "beat": "Колонна бывших пленных идёт по мосту; на середине — шлагбаум, американский и наш часовые",
        "show": "bridgeWide"
      },
      {
        "think": "Там, на той стороне, — красный флаг на грузовике. Свои."
      },
      {
        "beat": "Наш лейтенант у шлагбаума смотрит, как они проходят; Асан поравнялся с ним",
        "show": "bridgeOfficer"
      },
      {
        "say": "Лейтенант",
        "text": "Ну что, надоело немецкий хлеб есть?",
        "lang": "ru"
      },
      {
        "choose": "Асан",
        "text": "",
        "timer": 10,
        "options": [
          {
            "text": "«Надоело, товарищ лейтенант»",
            "then": [
              {
                "say": "Лейтенант",
                "text": "То-то. Проходи. Там разберутся.",
                "lang": "ru"
              }
            ]
          },
          {
            "text": "[Промолчать]",
            "then": [
              {
                "say": "Лейтенант",
                "text": "Молчит. Ну, там тебя разговорят.",
                "lang": "ru"
              }
            ]
          },
          {
            "text": "«Я его не ел. Я его зарабатывал»",
            "set": {
              "bridgeSass": true
            },
            "then": [
              {
                "say": "Лейтенант",
                "text": "Ишь ты. Запомню.",
                "lang": "ru"
              },
              {
                "remember": "Лейтенант на мосту запомнил твой ответ"
              }
            ]
          }
        ],
        "silent": 1
      },
      {
        "later": "Май 1945. Перешёл мост через Энс. На том берегу — свои."
      }
    ],
    "wire": [
      {
        "caption": "Проверочно-фильтрационный лагерь."
      },
      {
        "beat": "Та же колючая проволока, те же вышки; только часовые теперь говорят по-русски",
        "show": "wireWide"
      },
      {
        "think": "Проволока. Вышки. Только окрикивают теперь на моём втором языке."
      },
      {
        "beat": "На столбе у ворот искрит изолятор: проволока под током",
        "show": "spark"
      },
      {
        "think": "Я думал, на той стороне моста кончится. Не кончилось."
      },
      {
        "say": "Сосед по нарам",
        "text": "Срок никому не известен. А это не легче расстрела.",
        "lang": "ru"
      },
      {
        "say": "Часовой",
        "text": "Не растягиваться! По четыре!",
        "lang": "ru"
      },
      {
        "beat": "В бараке на нарах сидят такие же — в немецких обмотках, в чужих шинелях; все молчат",
        "show": "barrackQuiet"
      }
    ],
    "interrogation1": [
      {
        "caption": "Допрос первый."
      },
      {
        "beat": "Комната, стол, лампа; капитан Ракитин листает папку и не поднимает глаз",
        "show": "roomWide"
      },
      {
        "say": "Ракитин",
        "text": "Фамилия, имя, отчество. Год и место рождения. Кем и когда призван.",
        "lang": "ru"
      },
      {
        "say": "Асан",
        "text": "Нурбеков Асан Нурбекович. Двадцать третьего года. Акмолинская область. Призван в апреле сорок второго, Акмолинский военкомат."
      },
      {
        "say": "Ракитин",
        "text": "Где служил?",
        "lang": "ru"
      },
      {
        "say": "Асан",
        "text": "Дон, второй номер пулемётного расчёта. Потом Сталинград, разведка. Потом Северский Донец."
      },
      {
        "if": "raft==gun",
        "then": [
          {
            "say": "Ракитин",
            "text": "На Дону пулемёт вынес. Записано. Раненого оставил. Тоже записано.",
            "lang": "ru"
          }
        ],
        "else": [
          {
            "say": "Ракитин",
            "text": "Переправа через Дон. Где твой пулемёт, Нурбеков?",
            "lang": "ru"
          },
          {
            "choose": "Асан",
            "text": "",
            "timer": 12,
            "options": [
              {
                "if": "raft==wounded",
                "text": "«Тащил раненого лейтенанта. Пулемёт остался на берегу»",
                "then": [
                  {
                    "say": "Ракитин",
                    "text": "Совпадает с донесением политрука. Хоть тут не врёшь.",
                    "lang": "ru"
                  }
                ]
              },
              {
                "if": "raft==none",
                "text": "«Не помню, как оказался на плоту. Пулемёт остался»",
                "then": [
                  {
                    "say": "Ракитин",
                    "text": "Не помнишь. Политрук помнит.",
                    "lang": "ru"
                  }
                ]
              },
              {
                "text": "«Пулемёт вынес, сдал старшине»",
                "set": {
                  "lieDon": true
                },
                "then": [
                  {
                    "call": "mark",
                    "args": [
                      1
                    ]
                  },
                  {
                    "say": "Ракитин",
                    "text": "Интересно. А политрук пишет — бросил.",
                    "lang": "ru"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "say": "Ракитин",
        "text": "Где и при каких обстоятельствах попал в плен?",
        "lang": "ru"
      },
      {
        "choose": "Асан",
        "text": "",
        "timer": 14,
        "options": [
          {
            "text": "«Раненым. В поле у Донца, через двое суток. Нашла собака»",
            "set": {
              "capturedAns": "truth"
            },
            "then": [
              {
                "say": "Ракитин",
                "text": "Ранение покажи.",
                "lang": "ru"
              },
              {
                "beat": "Асан задирает штанину; Ракитин смотрит на шрам и криво сросшуюся кость",
                "show": "showScar"
              },
              {
                "say": "Ракитин",
                "text": "Ладно. Ранение подтверждается.",
                "lang": "ru"
              }
            ]
          },
          {
            "text": "«Окружили. Отстреливался до последнего патрона»",
            "set": {
              "capturedAns": "hero"
            },
            "then": [
              {
                "call": "mark",
                "args": [
                  1
                ]
              },
              {
                "say": "Ракитин",
                "text": "Все до последнего патрона. А в плену — живые. Как так выходит?",
                "lang": "ru"
              }
            ]
          },
          {
            "text": "«Не помню. Очнулся — уже немцы»",
            "set": {
              "capturedAns": "forgot"
            },
            "then": [
              {
                "say": "Ракитин",
                "text": "Удобно не помнить.",
                "lang": "ru"
              }
            ]
          }
        ]
      },
      {
        "say": "Ракитин",
        "text": "Свободен. Пока.",
        "lang": "ru"
      }
    ],
    "interrogation2": [
      {
        "caption": "Допрос второй. Через неделю."
      },
      {
        "beat": "Та же комната; на столе теперь две папки",
        "show": "roomWide"
      },
      {
        "say": "Ракитин",
        "text": "Что ты говорил немцам о себе? Кто ты, какой нации?",
        "lang": "ru"
      },
      {
        "choose": "Асан",
        "text": "",
        "timer": 12,
        "options": [
          {
            "text": "«Сказал, что мусульманин. Иначе бы расстреляли как еврея»",
            "then": [
              {
                "say": "Ракитин",
                "text": "Мусульманин. А в комсомоле был?",
                "lang": "ru"
              },
              {
                "say": "Асан",
                "text": "Не был. Неграмотный я был."
              }
            ]
          },
          {
            "text": "«Ничего не говорил»",
            "set": {
              "lieGermans": true
            },
            "then": [
              {
                "call": "mark",
                "args": [
                  1
                ]
              },
              {
                "say": "Ракитин",
                "text": "А в немецкой учётной карточке написано — «Muselmann». Сами придумали?",
                "lang": "ru"
              }
            ]
          }
        ]
      },
      {
        "say": "Ракитин",
        "text": "Вербовали тебя? В легион, во власовцы — куда угодно.",
        "lang": "ru"
      },
      {
        "choose": "Асан",
        "text": "",
        "timer": 14,
        "silent": 2,
        "options": [
          {
            "if": "legion==signed",
            "text": "«Подписал анкету. Взяли бы — не знаю. Не взяли: нога»",
            "set": {
              "legionConfessed": true
            },
            "then": [
              {
                "say": "Ракитин",
                "text": "Сам сказал. Это я тоже запишу. Сам — это другое.",
                "lang": "ru"
              },
              {
                "remember": "Ты сам признался Ракитину, что подписал анкету легиона"
              }
            ]
          },
          {
            "text": "«Вербовали. Я отказался»",
            "set": {
              "legionAns": "refused"
            },
            "then": [
              {
                "if": "legion==signed",
                "then": [
                  {
                    "call": "mark",
                    "args": [
                      1
                    ]
                  }
                ]
              },
              {
                "say": "Ракитин",
                "text": "Отказался. Запишем: отказался.",
                "lang": "ru"
              }
            ]
          },
          {
            "text": "[Промолчать]",
            "set": {
              "legionAns": "silent"
            },
            "then": [
              {
                "say": "Ракитин",
                "text": "Молчишь. Значит, было что-то.",
                "lang": "ru"
              },
              {
                "call": "mark",
                "args": [
                  1
                ]
              }
            ]
          }
        ]
      },
      {
        "say": "Ракитин",
        "text": "После лагеря где был?",
        "lang": "ru"
      },
      {
        "choose": "Асан",
        "text": "",
        "timer": 12,
        "options": [
          {
            "text": "«Батрачил на хуторе. Мешки, сено, коровы»",
            "then": [
              {
                "say": "Ракитин",
                "text": "На немца работал, значит.",
                "lang": "ru"
              },
              {
                "say": "Асан",
                "text": "Нас не спрашивали, на кого."
              }
            ]
          },
          {
            "text": "«Бежал. Был у партизан»",
            "set": {
              "liePartisans": true
            },
            "then": [
              {
                "call": "mark",
                "args": [
                  2
                ]
              },
              {
                "say": "Ракитин",
                "text": "В Австрии? У каких партизан? Фамилии командиров. Нет фамилий? Так и запишем.",
                "lang": "ru"
              }
            ]
          }
        ]
      }
    ],
    "interrogation3": [
      {
        "caption": "Допрос третий."
      },
      {
        "beat": "Ракитин раскладывает по столу листы — показания других людей",
        "show": "papers"
      },
      {
        "say": "Ракитин",
        "text": "Про тебя тут люди пишут. Послушай.",
        "lang": "ru"
      },
      {
        "if": "raft==wounded",
        "then": [
          {
            "say": "Ракитин",
            "text": "Майор Волков: «Рядовой Нурбеков вынес меня на плот под огнём». Майор теперь. Повезло тебе.",
            "lang": "ru"
          },
          {
            "call": "witness",
            "args": [
              1
            ]
          }
        ]
      },
      {
        "if": "dubrovin==hid",
        "then": [
          {
            "say": "Ракитин",
            "text": "Капитан Дубровин, бежавший из Маутхаузена: «Нурбеков прятал меня в сене, рискуя жизнью». Капитан за тебя ручается.",
            "lang": "ru"
          },
          {
            "call": "witness",
            "args": [
              1
            ]
          }
        ]
      },
      {
        "if": "vasily==betrayed",
        "then": [
          {
            "say": "Ракитин",
            "text": "А вот Сафонов Василий пишет: «Казах сдал меня полицаю за пайку». Было?",
            "lang": "ru"
          },
          {
            "think": "Василий. Живой. Картошка по полу."
          },
          {
            "call": "witness",
            "args": [
              -1
            ]
          }
        ],
        "else": [
          {
            "if": "vasily==kept",
            "then": [
              {
                "say": "Ракитин",
                "text": "Сафонов Василий: «Казах не выдал, хотя полицай сулил пайку».",
                "lang": "ru"
              },
              {
                "call": "witness",
                "args": [
                  1
                ]
              }
            ]
          }
        ]
      },
      {
        "if": "opBrave",
        "then": [
          {
            "say": "Ракитин",
            "text": "Военврач Синицын: «Раненый Нурбеков вёл себя стойко. В плен попал в бессознательном состоянии».",
            "lang": "ru"
          },
          {
            "call": "witness",
            "args": [
              1
            ]
          }
        ]
      },
      {
        "if": "shareFood==all",
        "then": [
          {
            "say": "Ракитин",
            "text": "Семён Кузьмин: «Делился последним». Ну, это к делу не относится. Но запишу.",
            "lang": "ru"
          }
        ]
      },
      {
        "if": "legion==signed",
        "then": [
          {
            "if": "!legionConfessed",
            "then": [
              {
                "beat": "Ракитин кладёт на стол немецкую карточку: латиницей, его рукой — «Nurbekov»",
                "show": "legionCard"
              },
              {
                "say": "Ракитин",
                "text": "Твоя подпись? Та же, что на повестке в сорок втором. Я сравнивал.",
                "lang": "ru"
              },
              {
                "call": "mark",
                "args": [
                  2
                ]
              },
              {
                "think": "Та же подпись. Как на повестке у загона."
              }
            ]
          }
        ]
      },
      {
        "say": "Ракитин",
        "text": "Теперь прочитай и распишись. На каждом листе.",
        "lang": "ru"
      },
      {
        "call": "protocol"
      }
    ],
    "zhumabai": [
      {
        "beat": "Панели: Жумабай в бараке, Жумабай в немецком кителе без погон, Жумабай шепчет",
        "show": "zhumPanels"
      },
      {
        "say": "Жумабай",
        "text": "Асан. Скажи им про партизан. Про легион не говори. Ты же со мной воду делил."
      },
      {
        "think": "Жумабай. Живой. Был в легионе — и ушёл от них к партизанам. Мать его — в нашем ауле, у колодца."
      }
    ],
    "friend": [
      {
        "say": "Ракитин",
        "text": "Последнее. Сеитказин Жумабай. Призывались вместе. Служил он у немцев?",
        "lang": "ru"
      },
      {
        "choose": "Асан",
        "text": "",
        "timer": 16,
        "silent": 1,
        "options": [
          {
            "text": "Всё как было: служил в легионе, потом ушёл к партизанам",
            "set": {
              "zhumAns": "truth"
            },
            "then": [
              {
                "say": "Ракитин",
                "text": "Совпадает. Слово в слово — он сам так и показал.",
                "lang": "ru"
              },
              {
                "think": "Он сам сказал? Тогда зачем просил меня молчать…"
              },
              {
                "remember": "Ты сказал Ракитину правду о Жумабае целиком"
              }
            ]
          },
          {
            "text": "«Не знаю такого»",
            "set": {
              "zhumAns": "unknown"
            },
            "then": [
              {
                "say": "Ракитин",
                "text": "Не знаешь. Из одного аула, в одном эшелоне. А вчера в бараке с кем шептался?",
                "lang": "ru"
              },
              {
                "call": "mark",
                "args": [
                  1
                ]
              },
              {
                "remember": "Ты сказал, что не знаешь Жумабая"
              }
            ]
          },
          {
            "text": "Только про партизан",
            "set": {
              "zhumAns": "cover"
            },
            "then": [
              {
                "say": "Ракитин",
                "text": "Только партизаны. А он сам про легион рассказал. Теперь у меня двое, которые врут.",
                "lang": "ru"
              },
              {
                "call": "mark",
                "args": [
                  2
                ]
              },
              {
                "remember": "Ты сказал про Жумабая только половину"
              }
            ]
          }
        ]
      },
      {
        "say": "Ракитин",
        "text": "Всё. Иди. Решение сообщат.",
        "lang": "ru"
      }
    ]
  },
  "panels": {
    "zhumabai": [
      {
        "art": "lineup",
        "text": "У соседнего барака Асан узнаёт его по походке. Седой в двадцать лет, без двух пальцев."
      },
      {
        "art": "tunic",
        "text": "После Дона — плен. В легион вступил, чтобы не умереть. Во Франции с другими перебил охрану и ушёл к партизанам."
      },
      {
        "art": "wire",
        "text": "Документов у него нет. Ночью Жумабай ложится на соседние нары и говорит шёпотом."
      }
    ]
  }
}