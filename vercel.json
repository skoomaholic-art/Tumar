{
  "cleanUrls": true,
  "headers": [
    { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/(js|css|data)/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/(art|models|sfx|music)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] }
  ]
}
